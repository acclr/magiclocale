{
  "name": "@keykithq/cli",
  "version": "0.1.2",
  "description": "Keykit CLI — scan keys, pull locale bundles, and apply migrations locally",
  "license": "MIT",
  "type": "module",
  "bin": {
    "keykit": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@keykithq/sdk": "workspace:*",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
